{
  "name": "excel-parser-backend",
  "version": "1.0.0",
  "description": "Robust Excel parser for .xls files with ISO-8859-1 encoding",
  "main": "backend/services/excelParser.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "excel",
    "parser",
    "xls",
    "iso-8859-1"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "xlsx": "^0.18.5",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "backend/**/*.js",
      "!backend/tests/**/*.js"
    ]
  }
}
