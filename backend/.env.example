# Configuração do Servidor
PORT=3000
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# Configuração JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# Configuração Bcrypt
BCRYPT_ROUNDS=10

# Configuração de Base de Dados (para futuro uso)
# DATABASE_URL=postgresql://username:password@localhost:5432/encomendas
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=encomendas
# DB_USER=username
# DB_PASSWORD=password

# Configuração de Email (para futuro uso)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Rate Limiting (para futuro uso)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Logs
# LOG_LEVEL=info
# LOG_FILE=logs/app.log